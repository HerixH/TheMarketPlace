# "testnet" or "public"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban escrow contract (see README: deploy with `stellar contract deploy`)
# Leave empty to disable escrow and only offer direct payments.
NEXT_PUBLIC_ESCROW_CONTRACT_ID=

# Optional overrides
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_USDC_ISSUER=

# Admin password used by `npm run seed`. Set this on any public deployment.
# ADMIN_PASSWORD=

# Optional. When set, cash out reads the mobile-money account name from Lenco.
# LENCO_API_KEY=
